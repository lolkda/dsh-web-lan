{
  "name": "@lolkda/dsh-web-lan",
  "version": "0.4.0",
  "description": "DSH LAN/VPN Web access through one concrete local interface address. Selects a local IPv4 by default, supports explicit bind and trusted authorities, token-free /go entry, and remote settings through public plugin APIs without modifying DSH.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lolkda/dsh-web-lan.git"
  },
  "homepage": "https://github.com/lolkda/dsh-web-lan#readme",
  "bugs": "https://github.com/lolkda/dsh-web-lan/issues",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./bind": "./lib/bind.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "verify-notes": "node --test test/notes.test.js",
    "test:runtime": "node scripts/test-runtime.mjs",
    "check": "node --check lib/index.js && node --check lib/bind.js && node --check lib/client.js && node --check scripts/release.mjs && node --test && npm run verify-notes"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": "*",
      "profiles": [
        "web"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-include": "~1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-models": "0.1.7-rc.1",
    "js-yaml": "^4.3.2",
    "react": "18.3.1"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "web",
    "lan",
    "sdwan",
    "tailscale",
    "zero-tier"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
