{
  "name": "@lolkda/dsh-web-lan",
  "version": "0.1.0",
  "description": "Let `dsh web` be reachable from other machines on the LAN / a virtual LAN (SD-WAN, Tailscale, ZeroTier) with no extra command line: ships a profile patch layer that binds all interfaces, widens the /api Host trust fence, and extends the browser-session cookie. Optional token-free entry at /go.",
  "repository": { "type": "git", "url": "git+https://github.com/lolkda/dsh-web-lan.git" },
  "homepage": "https://github.com/lolkda/dsh-web-lan#readme",
  "bugs": "https://github.com/lolkda/dsh-web-lan/issues",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.1 <0.2.0",
      "profiles": [
        "web"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "web",
    "lan",
    "sdwan",
    "tailscale",
    "zero-tier"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
